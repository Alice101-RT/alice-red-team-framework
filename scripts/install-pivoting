#!/bin/bash

# ==========================================================
# Alice Red Team Framework - Pivoting / Tunneling Installer
# ==========================================================

set -e

PINK="\033[1;35m"
CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

echo -e "${PINK}"
echo "    ___    __    ____________"
echo "   /   |  / /   /  _/ ____/ /"
echo "  / /| | / /    / // /   / / "
echo " / ___ |/ /____/ // /___/ /___"
echo "/_/  |_/_____/___/\____/_____/"
echo -e "${RESET}"

echo -e "${CYAN}ALICE RED TEAM FRAMEWORK - PIVOTING / TUNNELING MODULE${RESET}"
echo

if ! command -v pacman >/dev/null 2>&1; then
    echo -e "${RED}[!] pacman not found. This installer is intended for Arch Linux based systems.${RESET}"
    exit 1
fi

if [ "$EUID" -eq 0 ]; then
    echo -e "${RED}[!] Do not run this script as root.${RESET}"
    echo -e "${YELLOW}Run it as your normal user. The script will ask for sudo when needed.${RESET}"
    exit 1
fi

echo -e "${PINK}[+] Installing official pivoting / tunneling support packages...${RESET}"

sudo pacman -Syu --needed \
    openssh \
    socat \
    proxychains-ng \
    sshuttle \
    tcpdump \
    wireshark-cli \
    iproute2 \
    iptables-nft \
    nftables

echo
echo -e "${PINK}[+] Installing Chisel...${RESET}"

if ! command -v chisel >/dev/null 2>&1; then
    sudo pacman -S --needed go
    go install github.com/jpillora/chisel@v1.13.0
fi

echo -e "${PINK}[+] Installing Ligolo-ng...${RESET}"

LIGOLO_VERSION="0.9.2"
LIGOLO_DIR="$HOME/Tools/ligolo-ng"

mkdir -p "$LIGOLO_DIR/proxy" "$LIGOLO_DIR/agent"

for component in proxy agent; do
    archive="ligolo-ng_${component}_${LIGOLO_VERSION}_linux_amd64.tar.gz"

    if [[ ! -x "$LIGOLO_DIR/$component/$component" ]]; then
        curl -fL \
            "https://github.com/nicocha30/ligolo-ng/releases/download/v${LIGOLO_VERSION}/${archive}" \
            -o "$LIGOLO_DIR/$archive"

        tar -xzf "$LIGOLO_DIR/$archive" \
            -C "$LIGOLO_DIR/$component"

        chmod +x "$LIGOLO_DIR/$component/$component"
    fi
done

echo "[+] Chisel and Ligolo-ng prepared."

echo -e "${PINK}[+] Creating pivoting / tunneling workspace directories...${RESET}"

mkdir -p "$HOME/Tools/pivoting"
mkdir -p "$HOME/Tools/tunneling"
mkdir -p "$HOME/Tools/proxying"
mkdir -p "$HOME/Tools/pivoting/manual"
mkdir -p "$HOME/Tools/tunneling/manual"

echo
echo -e "${GREEN}[+] Pivoting / Tunneling module installation completed.${RESET}"
echo
echo -e "${CYAN}Recommended checks:${RESET}"
echo "ssh -V"
echo "socat -V"
echo "proxychains4 -h"
echo "sshuttle --version"
echo "tcpdump --version"
echo "tshark --version"
echo "chisel --version"
echo "ligolo-ng -h"
echo
echo -e "${YELLOW}Notes:${RESET}"
echo "- This installer does not configure tunnels automatically."
echo "- This installer does not modify routing tables automatically."
echo "- This installer does not start proxy services."
echo "- Use pivoting and tunneling only under approved ROE."
echo "- Document source, destination, ports, routes and cleanup steps."
echo
