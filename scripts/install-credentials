#!/bin/bash

# ==========================================================
# Alice Red Team Workstation - Credentials / Secrets Installer
# ==========================================================

set -e

PINK="\033[1;35m"
CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

echo -e "${PINK}"
echo "    ___    __    ____________"
echo "   /   |  / /   /  _/ ____/ /"
echo "  / /| | / /    / // /   / / "
echo " / ___ |/ /____/ // /___/ /___"
echo "/_/  |_/_____/___/\____/_____/"
echo -e "${RESET}"

echo -e "${CYAN}ALICE RED TEAM WORKSTATION - CREDENTIALS / SECRETS MODULE${RESET}"
echo

if ! command -v pacman >/dev/null 2>&1; then
    echo -e "${RED}[!] pacman not found. This installer is intended for Arch Linux based systems.${RESET}"
    exit 1
fi

if [ "$EUID" -eq 0 ]; then
    echo -e "${RED}[!] Do not run this script as root.${RESET}"
    echo -e "${YELLOW}Run it as your normal user. The script will ask for sudo when needed.${RESET}"
    exit 1
fi

# ----------------------------------------------------------
# Official packages
# ----------------------------------------------------------

echo -e "${PINK}[+] Installing official credentials / secrets packages...${RESET}"

sudo pacman -Syu --needed \
    john \
    hashcat \
    hashcat-utils \
    python \
    python-pip \
    python-pipx \
    git \
    curl \
    jq

# ----------------------------------------------------------
# AUR packages
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Checking yay availability...${RESET}"

if command -v yay >/dev/null 2>&1; then
    echo -e "${PINK}[+] Installing AUR credentials / wordlist packages where available...${RESET}"

    yay -S --needed \
        hashid \
        seclists \
        cewl \
        crunch \
        git-secrets || true
else
    echo -e "${YELLOW}[!] yay is not installed. Skipping AUR-based tools.${RESET}"
fi

# ----------------------------------------------------------
# pipx tools
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Installing pipx-based credentials / secrets tools...${RESET}"

python -m pipx ensurepath

pipx install name-that-hash || true
pipx install detect-secrets || true

# ----------------------------------------------------------
# Go tools
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Checking Go availability...${RESET}"

if ! command -v go >/dev/null 2>&1; then
    echo -e "${YELLOW}[!] Go is not installed.${RESET}"
    echo -e "${YELLOW}Installing Go...${RESET}"
    sudo pacman -S --needed go
fi

echo -e "${PINK}[+] Installing Go-based secrets tools...${RESET}"

go install github.com/gitleaks/gitleaks/v8@latest
go install github.com/trufflesecurity/trufflehog/v3@latest

# ----------------------------------------------------------
# Workspace directories
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Creating credentials / secrets workspace directories...${RESET}"

mkdir -p "$HOME/Tools/credentials"
mkdir -p "$HOME/Tools/secrets"
mkdir -p "$HOME/Tools/wordlists"
mkdir -p "$HOME/Wordlists"/{web,passwords,usernames,custom,rules}
mkdir -p "$HOME/Loot"/{creds,hashes,tokens,keys}

# ----------------------------------------------------------
# Final message
# ----------------------------------------------------------

echo
echo -e "${GREEN}[+] Credentials / Secrets module installation completed.${RESET}"
echo
echo -e "${CYAN}Recommended checks:${RESET}"
echo "john --list=formats"
echo "hashcat --version"
echo "hashid --help"
echo "nth --help"
echo "detect-secrets --help"
echo "gitleaks version"
echo "trufflehog --help"
echo
echo -e "${YELLOW}Notes:${RESET}"
echo "- Credential material is sensitive."
echo "- Do not commit credentials, hashes, tokens, keys or loot."
echo "- Store operational material only inside target-specific loot folders."
echo "- Validate credentials only under approved ROE."
echo "- Ensure your shell PATH includes \$HOME/go/bin for Go tools."
echo
