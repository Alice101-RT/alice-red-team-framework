#!/bin/bash

# ==========================================================
# Alice Red Team Workstation - C2 / Adversary Emulation Support Installer
# ==========================================================

set -e

PINK="\033[1;35m"
CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

echo -e "${PINK}"
echo "    ___    __    ____________"
echo "   /   |  / /   /  _/ ____/ /"
echo "  / /| | / /    / // /   / / "
echo " / ___ |/ /____/ // /___/ /___"
echo "/_/  |_/_____/___/\____/_____/"
echo -e "${RESET}"

echo -e "${CYAN}ALICE RED TEAM WORKSTATION - C2 / ADVERSARY EMULATION SUPPORT${RESET}"
echo

if ! command -v pacman >/dev/null 2>&1; then
    echo -e "${RED}[!] pacman not found. This installer is intended for Arch Linux based systems.${RESET}"
    exit 1
fi

if [ "$EUID" -eq 0 ]; then
    echo -e "${RED}[!] Do not run this script as root.${RESET}"
    echo -e "${YELLOW}Run it as your normal user. The script will ask for sudo when needed.${RESET}"
    exit 1
fi

echo -e "${YELLOW}[!] This installer does not deploy C2 frameworks.${RESET}"
echo -e "${YELLOW}[!] It only installs supporting dependencies and creates workspace directories.${RESET}"
echo

read -r -p "Continue with support dependency installation? [y/N] " CONFIRM

if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    echo -e "${YELLOW}[*] Installation cancelled.${RESET}"
    exit 0
fi

# ----------------------------------------------------------
# Official support packages
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Installing C2 / adversary emulation support packages...${RESET}"

sudo pacman -Syu --needed \
    git \
    docker \
    docker-compose \
    go \
    python \
    python-pip \
    python-pipx \
    nodejs \
    npm \
    jq \
    openssl \
    nginx \
    yara \
    tcpdump \
    wireshark-cli \
    tmux \
    curl \
    wget \
    unzip

# ----------------------------------------------------------
# Docker group
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Checking Docker service...${RESET}"

sudo systemctl enable docker || true

echo
echo -e "${YELLOW}[*] Docker has been enabled but not started automatically by this script.${RESET}"
echo -e "${YELLOW}[*] Start it manually with: sudo systemctl start docker${RESET}"

if groups "$USER" | grep -q '\bdocker\b'; then
    echo -e "${GREEN}[+] User already belongs to docker group.${RESET}"
else
    echo -e "${YELLOW}[*] Adding user to docker group for local lab usage.${RESET}"
    sudo usermod -aG docker "$USER"
    echo -e "${YELLOW}[!] Log out and log back in for docker group changes to apply.${RESET}"
fi

# ----------------------------------------------------------
# Workspace directories
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Creating C2 / adversary emulation workspace directories...${RESET}"

mkdir -p "$HOME/Tools/c2"
mkdir -p "$HOME/Tools/adversary-emulation"
mkdir -p "$HOME/Tools/c2/manual"
mkdir -p "$HOME/Tools/adversary-emulation/manual"
mkdir -p "$HOME/Tools/c2/infrastructure"
mkdir -p "$HOME/Tools/c2/payload-analysis"
mkdir -p "$HOME/Labs/AdversaryEmulation"
mkdir -p "$HOME/Labs/C2"
mkdir -p "$HOME/Reports/adversary-emulation"

# ----------------------------------------------------------
# Manual review notes
# ----------------------------------------------------------

cat > "$HOME/Tools/c2/README.md" << 'C2README'
# C2 / Adversary Emulation Workspace

This directory is reserved for manually reviewed C2 and adversary emulation tooling.

Do not place real operational data here.

Do not commit payloads, listeners, credentials, infrastructure configs or client data.

Recommended tools to review manually:

- Sliver
- Mythic
- Havoc
- Covenant
- Caldera
- Atomic Red Team

Use only under approved Rules of Engagement.
C2README

# ----------------------------------------------------------
# Final message
# ----------------------------------------------------------

echo
echo -e "${GREEN}[+] C2 / Adversary Emulation support installation completed.${RESET}"
echo
echo -e "${CYAN}Recommended checks:${RESET}"
echo "docker --version"
echo "go version"
echo "python --version"
echo "pipx --version"
echo "node --version"
echo "npm --version"
echo "yara --version"
echo "tcpdump --version"
echo "tshark --version"
echo
echo -e "${YELLOW}Important notes:${RESET}"
echo "- This installer does not install Sliver, Mythic, Havoc, Covenant or Caldera."
echo "- This installer does not start listeners."
echo "- This installer does not generate payloads."
echo "- This installer does not run emulation tests."
echo "- C2 tooling must be installed and executed manually under approved ROE."
echo "- Log out and log back in if docker group membership was changed."
echo
