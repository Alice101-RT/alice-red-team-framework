#!/bin/bash

# ==========================================================
# Alice Red Team Framework - Web / API Installer
# ==========================================================

set -e

PINK="\033[1;35m"
CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

echo -e "${PINK}"
echo "    ___    __    ____________"
echo "   /   |  / /   /  _/ ____/ /"
echo "  / /| | / /    / // /   / / "
echo " / ___ |/ /____/ // /___/ /___"
echo "/_/  |_/_____/___/\____/_____/"
echo -e "${RESET}"

echo -e "${CYAN}ALICE RED TEAM FRAMEWORK - WEB / API MODULE${RESET}"
echo

if ! command -v pacman >/dev/null 2>&1; then
    echo -e "${RED}[!] pacman not found. This installer is intended for Arch Linux based systems.${RESET}"
    exit 1
fi

if [ "$EUID" -eq 0 ]; then
    echo -e "${RED}[!] Do not run this script as root.${RESET}"
    echo -e "${YELLOW}Run it as your normal user. The script will ask for sudo when needed.${RESET}"
    exit 1
fi

# ----------------------------------------------------------
# Official packages
# ----------------------------------------------------------

echo -e "${PINK}[+] Installing official Web/API packages...${RESET}"

sudo pacman -Syu --needed \
    gobuster \
    nikto \
    sqlmap \
    jq \
    curl \
    wget \
    python \
    python-pip \
    python-pipx

# ----------------------------------------------------------
# AUR packages
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Checking yay availability...${RESET}"

if ! command -v yay >/dev/null 2>&1; then
    echo -e "${YELLOW}[!] yay is not installed.${RESET}"
    echo -e "${YELLOW}Skipping AUR tools. Install yay first if you want AUR-based tools.${RESET}"
else
    echo -e "${PINK}[+] Installing AUR Web/API packages...${RESET}"

    yay -S --needed \
        burpsuite \
        ffuf \
        feroxbuster \
        dirsearch \
        seclists
fi

# ----------------------------------------------------------
# Go tools
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Checking Go availability...${RESET}"

if ! command -v go >/dev/null 2>&1; then
    echo -e "${YELLOW}[!] Go is not installed.${RESET}"
    echo -e "${YELLOW}Installing Go...${RESET}"
    sudo pacman -S --needed go
fi

echo -e "${PINK}[+] Installing Go-based Web/API tools...${RESET}"

go install github.com/projectdiscovery/httpx/cmd/httpx@latest
go install github.com/projectdiscovery/katana/cmd/katana@latest
go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest
go install github.com/projectdiscovery/dnsx/cmd/dnsx@latest
go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest
go install github.com/hahwul/dalfox/v2@latest

# ----------------------------------------------------------
# pipx tools
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Installing pipx-based Web/API tools...${RESET}"

python -m pipx ensurepath

pipx install arjun || true

# ----------------------------------------------------------
# Final message
# ----------------------------------------------------------

echo
echo -e "${GREEN}[+] Web / API module installation completed.${RESET}"
echo
echo -e "${CYAN}Recommended checks:${RESET}"
echo "burpsuite"
echo "ffuf -V"
echo "feroxbuster --version"
echo "gobuster version"
echo "sqlmap --version"
echo "httpx -version"
echo "katana -version"
echo "subfinder -version"
echo "dnsx -version"
echo "nuclei -version"
echo "dalfox version"
echo "arjun -h"
echo
echo -e "${YELLOW}Note:${RESET} Go tools are installed under ~/go/bin."
echo -e "${YELLOW}Ensure your shell PATH includes:${RESET} \$HOME/go/bin"
