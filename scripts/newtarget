#!/bin/bash

# ==========================================================
# newtarget - Alice Arch Red Team tmux workspace
# ==========================================================
# Usage:
#   newtarget <target-name>
# Example:
#   newtarget htb-lame
# ==========================================================

if [ -z "$1" ]; then
    printf "\033[1;35mUsage:\033[0m newtarget <target-name>\n"
    printf "\033[1;36mExample:\033[0m newtarget htb-lame\n"
    exit 1
fi

TARGET="$1"
BASE_DIR="$HOME/Labs/$TARGET"

mkdir -p "$BASE_DIR"/{recon,enum,attack,shell,privesc,exfil,loot,notes,services,scans,screenshots,reports}

if tmux has-session -t "$TARGET" 2>/dev/null; then
    printf "\033[1;33m[*] Session '%s' already exists. Attaching...\033[0m\n" "$TARGET"
    tmux attach-session -t "$TARGET"
    exit 0
fi

printf "\033[1;35m[+] Creating target workspace:\033[0m \033[1;36m%s\033[0m\n" "$BASE_DIR"
printf "\033[1;35m[+] Creating tmux session:\033[0m \033[1;36m%s\033[0m\n" "$TARGET"

tmux new-session -d -s "$TARGET" -n recon -c "$BASE_DIR/recon"

tmux new-window -t "$TARGET":2 -n enum     -c "$BASE_DIR/enum"
tmux new-window -t "$TARGET":3 -n attack   -c "$BASE_DIR/attack"
tmux new-window -t "$TARGET":4 -n shell    -c "$BASE_DIR/shell"
tmux new-window -t "$TARGET":5 -n privesc  -c "$BASE_DIR/privesc"
tmux new-window -t "$TARGET":6 -n exfil    -c "$BASE_DIR/exfil"
tmux new-window -t "$TARGET":7 -n loot     -c "$BASE_DIR/loot"
tmux new-window -t "$TARGET":8 -n notes    -c "$BASE_DIR/notes"
tmux new-window -t "$TARGET":9 -n services -c "$BASE_DIR/services"

touch "$BASE_DIR/notes/${TARGET}.md"

tmux select-window -t "$TARGET":1
tmux attach-session -t "$TARGET"
