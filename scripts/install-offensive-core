#!/bin/bash

# ==========================================================
# Alice Red Team Workstation - Offensive Core Installer
# ==========================================================

set -e

PINK="\033[1;35m"
CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

echo -e "${PINK}"
echo "    ___    __    ____________"
echo "   /   |  / /   /  _/ ____/ /"
echo "  / /| | / /    / // /   / / "
echo " / ___ |/ /____/ // /___/ /___"
echo "/_/  |_/_____/___/\____/_____/"
echo -e "${RESET}"

echo -e "${CYAN}ALICE RED TEAM WORKSTATION - OFFENSIVE CORE${RESET}"
echo

if ! command -v pacman >/dev/null 2>&1; then
    echo -e "${RED}[!] pacman not found. This installer is intended for Arch Linux based systems.${RESET}"
    exit 1
fi

if [ "$EUID" -eq 0 ]; then
    echo -e "${RED}[!] Do not run this script as root.${RESET}"
    echo -e "${YELLOW}Run it as your normal user. The script will ask for sudo when needed.${RESET}"
    exit 1
fi

echo -e "${PINK}[+] Installing official offensive core packages...${RESET}"

sudo pacman -Syu --needed \
    nmap \
    masscan \
    openbsd-netcat \
    socat \
    rlwrap \
    tcpdump \
    wireshark-qt \
    wireshark-cli \
    whois \
    bind \
    traceroute \
    inetutils \
    proxychains-ng \
    gobuster \
    nikto \
    sqlmap \
    john \
    hashcat \
    flameshot \
    spectacle \
    perl-image-exiftool

echo
echo -e "${PINK}[+] Checking yay availability...${RESET}"

if ! command -v yay >/dev/null 2>&1; then
    echo -e "${YELLOW}[!] yay is not installed.${RESET}"
    echo -e "${YELLOW}Install yay before installing AUR-based tools.${RESET}"
    echo
    echo "Manual yay installation:"
    echo "cd /tmp"
    echo "git clone https://aur.archlinux.org/yay.git"
    echo "cd yay"
    echo "makepkg -si"
    exit 0
fi

echo -e "${PINK}[+] Installing AUR offensive core packages...${RESET}"

yay -S --needed \
    ffuf \
    feroxbuster \
    whatweb \
    seclists \
    cewl \
    crunch \
    rustscan \
    burpsuite \
    evil-winrm \
    enum4linux-ng \
    smbmap

echo
echo -e "${GREEN}[+] Offensive core installation completed.${RESET}"
echo
echo -e "${CYAN}Recommended checks:${RESET}"
echo "nmap --version"
echo "ffuf -V"
echo "feroxbuster --version"
echo "burpsuite"
echo "newtarget first-lab"
echo
