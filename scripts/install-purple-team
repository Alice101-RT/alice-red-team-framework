#!/bin/bash

# ==========================================================
# Alice Red Team Framework - Purple Team / Detection Installer
# ==========================================================

set -e

PINK="\033[1;35m"
CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

echo -e "${PINK}"
echo "    ___    __    ____________"
echo "   /   |  / /   /  _/ ____/ /"
echo "  / /| | / /    / // /   / / "
echo " / ___ |/ /____/ // /___/ /___"
echo "/_/  |_/_____/___/\____/_____/"
echo -e "${RESET}"

echo -e "${CYAN}ALICE RED TEAM FRAMEWORK - PURPLE TEAM / DETECTION MODULE${RESET}"
echo

if ! command -v pacman >/dev/null 2>&1; then
    echo -e "${RED}[!] pacman not found. This installer is intended for Arch Linux based systems.${RESET}"
    exit 1
fi

if [ "$EUID" -eq 0 ]; then
    echo -e "${RED}[!] Do not run this script as root.${RESET}"
    echo -e "${YELLOW}Run it as your normal user. The script will ask for sudo when needed.${RESET}"
    exit 1
fi

# ----------------------------------------------------------
# Official packages
# ----------------------------------------------------------

echo -e "${PINK}[+] Installing official Purple Team / Detection packages...${RESET}"

sudo pacman -Syu --needed \
    yara \
    suricata \
    zeek \
    wireshark-qt \
    wireshark-cli \
    tcpdump \
    jq \
    python \
    python-pip \
    python-pipx \
    git \
    curl \
    wget \
    unzip

# ----------------------------------------------------------
# AUR packages
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Checking yay availability...${RESET}"

if command -v yay >/dev/null 2>&1; then
    echo -e "${PINK}[+] Installing optional AUR Purple Team tools where available...${RESET}"

    yay -S --needed \
        osquery \
        sigma-cli \
        chainsaw \
        hayabusa || true
else
    echo -e "${YELLOW}[!] yay is not installed. Skipping AUR-based tools.${RESET}"
fi

# ----------------------------------------------------------
# pipx tools
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Installing pipx-based detection tools...${RESET}"

python -m pipx ensurepath

pipx install sigma-cli || true
pipx install timesketch-cli-client || true
pipx install plaso || true

# ----------------------------------------------------------
# Manual / GitHub workspace
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Creating Purple Team workspace directories...${RESET}"

mkdir -p "$HOME/Tools/purple-team"
mkdir -p "$HOME/Tools/detection"
mkdir -p "$HOME/Tools/sigma"
mkdir -p "$HOME/Tools/yara"
mkdir -p "$HOME/Tools/atomic-red-team"
mkdir -p "$HOME/Tools/windows-event-analysis"
mkdir -p "$HOME/Labs/PurpleTeam"
mkdir -p "$HOME/Labs/DetectionEngineering"

# ----------------------------------------------------------
# Optional manual repositories
# ----------------------------------------------------------

echo
echo -e "${YELLOW}[*] Manual tools are not cloned automatically by default.${RESET}"
echo
echo "Recommended manual tools to review:"
echo "- Atomic Red Team: https://github.com/redcanaryco/atomic-red-team"
echo "- Sigma: https://github.com/SigmaHQ/sigma"
echo "- Hayabusa: https://github.com/Yamato-Security/hayabusa"
echo "- Chainsaw: https://github.com/WithSecureLabs/chainsaw"
echo "- Velociraptor: https://github.com/Velocidex/velociraptor"
echo "- ATT&CK Navigator: https://github.com/mitre-attack/attack-navigator"

# ----------------------------------------------------------
# Final message
# ----------------------------------------------------------

echo
echo -e "${GREEN}[+] Purple Team / Detection module installation completed.${RESET}"
echo
echo -e "${CYAN}Recommended checks:${RESET}"
echo "yara --version"
echo "suricata --build-info"
echo "zeek --version"
echo "tshark --version"
echo "tcpdump --version"
echo "sigma --help"
echo "osqueryi --version"
echo "chainsaw --help"
echo "hayabusa --help"
echo
echo -e "${YELLOW}Notes:${RESET}"
echo "- This installer does not execute adversary emulation tests."
echo "- This installer does not configure SIEM, EDR or SOAR integrations."
echo "- Atomic Red Team and similar frameworks should only be executed under approved ROE."
echo "- Detection validation should be documented with timestamps, telemetry, expected alerts and observed results."
echo
