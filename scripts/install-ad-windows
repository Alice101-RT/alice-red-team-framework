#!/bin/bash

# ==========================================================
# Alice Red Team Framework - AD / Windows Internal Installer
# ==========================================================

set -e

PINK="\033[1;35m"
CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

echo -e "${PINK}"
echo "    ___    __    ____________"
echo "   /   |  / /   /  _/ ____/ /"
echo "  / /| | / /    / // /   / / "
echo " / ___ |/ /____/ // /___/ /___"
echo "/_/  |_/_____/___/\____/_____/"
echo -e "${RESET}"

echo -e "${CYAN}ALICE RED TEAM FRAMEWORK - AD / WINDOWS MODULE${RESET}"
echo

if ! command -v pacman >/dev/null 2>&1; then
    echo -e "${RED}[!] pacman not found. This installer is intended for Arch Linux based systems.${RESET}"
    exit 1
fi

if [ "$EUID" -eq 0 ]; then
    echo -e "${RED}[!] Do not run this script as root.${RESET}"
    echo -e "${YELLOW}Run it as your normal user. The script will ask for sudo when needed.${RESET}"
    exit 1
fi

# ----------------------------------------------------------
# Official packages
# ----------------------------------------------------------

echo -e "${PINK}[+] Installing official AD / Windows support packages...${RESET}"

sudo pacman -Syu --needed \
    samba \
    smbclient \
    openldap \
    bind \
    krb5 \
    python \
    python-pip \
    python-pipx \
    freerdp \
    nmap

# ----------------------------------------------------------
# AUR packages
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Checking yay availability...${RESET}"

if ! command -v yay >/dev/null 2>&1; then
    echo -e "${YELLOW}[!] yay is not installed.${RESET}"
    echo -e "${YELLOW}Skipping AUR tools. Install yay first if you want AUR-based tools.${RESET}"
else
    echo -e "${PINK}[+] Installing AUR AD / Windows tools...${RESET}"

    yay -S --needed \
        evil-winrm \
        enum4linux-ng \
        smbmap \
        bloodhound \
        neo4j
fi

# ----------------------------------------------------------
# pipx tools
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Installing pipx-based AD / Windows tools...${RESET}"

python -m pipx ensurepath

echo "[*] Impacket is managed by Pacman."
command -v nxc >/dev/null 2>&1 || pipx install git+https://github.com/Pennyw0rth/NetExec
pipx install bloodhound || true
command -v certipy >/dev/null 2>&1 || pipx install certipy-ad
pipx install ldapdomaindump || true
pipx install adidnsdump || true

# ----------------------------------------------------------
# Go tools
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Checking Go availability...${RESET}"

if ! command -v go >/dev/null 2>&1; then
    echo -e "${YELLOW}[!] Go is not installed.${RESET}"
    echo -e "${YELLOW}Installing Go...${RESET}"
    sudo pacman -S --needed go
fi

echo -e "${PINK}[+] Installing Go-based AD tools...${RESET}"

go install github.com/ropnop/kerbrute@latest

# ----------------------------------------------------------
# Workspace directories
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Creating AD / Windows tooling directories...${RESET}"

mkdir -p "$HOME/Tools/ad"
mkdir -p "$HOME/Tools/windows"
mkdir -p "$HOME/Tools/windows/manual"
mkdir -p "$HOME/Tools/windows/collectors"

# ----------------------------------------------------------

# Evil-WinRM (RubyGems)
if ! command -v evil-winrm >/dev/null 2>&1; then
    sudo pacman -S --needed ruby
    gem install erb evil-winrm --user-install
fi

# Final message
# ----------------------------------------------------------

echo
echo -e "${GREEN}[+] AD / Windows Internal module installation completed.${RESET}"
echo
echo -e "${CYAN}Recommended checks:${RESET}"
echo "impacket-GetNPUsers -h"
echo "netexec --help"
echo "evil-winrm -h"
echo "smbmap -h"
echo "enum4linux-ng -h"
echo "certipy -h"
echo "bloodhound-python -h"
echo "kerbrute -h"
echo
echo -e "${YELLOW}Notes:${RESET}"
echo "- Go tools are installed under ~/go/bin."
echo "- Ensure your shell PATH includes \$HOME/go/bin."
echo "- Windows-only tools such as SharpHound, Rubeus, PowerView, WinPEAS and Snaffler are documented but not installed automatically."
echo "- Use these tools only in approved labs or authorized operations."
echo
