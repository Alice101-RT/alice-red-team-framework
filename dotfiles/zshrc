# ==========================================================
# Alice Red Team Framework - ZSH Configuration
# ==========================================================

# -------------------------
# Environment
# -------------------------

export EDITOR=nvim
export VISUAL=nvim
export LANG=en_US.UTF-8
export PATH="$HOME/Scripts:$HOME/go/bin:$PATH"

# -------------------------
# History
# -------------------------

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

setopt appendhistory
setopt sharehistory
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt inc_append_history

# -------------------------
# Zsh Completion System
# -------------------------

autoload -Uz compinit
compinit

# Completion behavior
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' verbose yes
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{magenta}-- %d --%f'
zstyle ':completion:*:messages' format '%F{cyan}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}-- no matches found --%f'

# Colored completion list
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Show completion list/menu
setopt auto_list
setopt auto_menu
setopt always_to_end
setopt complete_in_word

# Better completion navigation
bindkey '^[[Z' reverse-menu-complete

# -------------------------
# Basic Aliases
# -------------------------

alias c='clear'
alias cls='clear'
alias update='sudo pacman -Syu'
alias install='sudo pacman -S'
alias search='pacman -Ss'
alias remove='sudo pacman -Rns'

# -------------------------
# Navigation
# -------------------------

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# -------------------------
# Modern Listing
# -------------------------

alias ls='eza --icons --group-directories-first'
alias ll='eza -lah --icons --group-directories-first'
alias la='eza -la --icons --group-directories-first'
alias lt='eza --tree --icons --group-directories-first'
alias cat='bat'

# -------------------------
# System
# -------------------------

alias myip='ip -br a'
alias ports='ss -tulpn'
alias path='echo -e ${PATH//:/\\n}'
alias ff='fastfetch'
alias banner='alicebanner'

# -------------------------
# Red Team Workspace Navigation
# -------------------------

alias labs='cd ~/Labs'
alias htb='cd ~/Labs/HTB'
alias thm='cd ~/Labs/THM'
alias oscp='cd ~/Labs/OSCP'
alias psw='cd ~/Labs/PortSwigger'

alias tools='cd ~/Tools'
alias recon='cd ~/Tools/recon'
alias webtools='cd ~/Tools/web'
alias adtools='cd ~/Tools/ad'
alias privesc='cd ~/Tools/privesc'

alias notes='cd ~/Notes'
alias loot='cd ~/Loot'
alias reports='cd ~/Reports'
alias payloads='cd ~/Payloads'
alias wordlists='cd ~/Wordlists'
alias scripts='cd ~/Scripts'
alias projects='cd ~/Projects'

# -------------------------
# tmux Shortcuts
# -------------------------

alias tls='tmux ls'
alias ta='tmux attach -t'
alias tk='tmux kill-session -t'
alias tn='tmux new -s'

# -------------------------
# Safety / Workspace Creation
# -------------------------

mkdir -p ~/Tools/{recon,web,ad,privesc,postexploitation}
mkdir -p ~/Wordlists/{web,passwords,usernames}
mkdir -p ~/Payloads/{web,shells,windows,linux}
mkdir -p ~/Loot/{creds,hashes,configs,screenshots,pcaps}
mkdir -p ~/Reports/{templates,finished,drafts}



# -------------------------
# Zsh Plugins
# -------------------------

source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh



# -------------------------
# Starship Prompt
# -------------------------

eval "$(starship init zsh)"


# ALICE ADVANCED SYNTAX HIGHLIGHTING

# Command types
ZSH_HIGHLIGHT_STYLES[command]='fg=#A5CFD5,bold'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#A5CFD5,bold'
ZSH_HIGHLIGHT_STYLES[function]='fg=#C6B3E6,bold'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#B5E0AD,bold'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=#C6B3E6,bold'

# Paths
ZSH_HIGHLIGHT_STYLES[path]='fg=#F3D49B,underline'
ZSH_HIGHLIGHT_STYLES[path_prefix]='fg=#F3D49B'

# Arguments and strings
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#E99EBB'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#F096B2'

# Options
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=#F3D49B'
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=#C6B3E6'

# Variables and operators
ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]='fg=#A5CFD5'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=#C6B3E6,bold'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=#F3D49B,bold'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=#B5E0AD'

# Errors
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#F38BA8,bold'

# Autosuggestions
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#777B91'

# Alice Pastel - Modern CLI
alias ls='eza --icons=always --color=always --group-directories-first'
alias ll='eza -lah --icons=always --color=always --group-directories-first'
alias la='eza -a --icons=always --color=always --group-directories-first'
alias lt='eza --tree --level=2 --icons=always --color=always'

export CLICOLOR=1
export EZA_COLORS='di=38;2;165;207;213:fi=38;2;239;239;241:ex=38;2;181;224;173:ln=38;2;198;179;230:*.md=38;2;240;150;178:*.sh=38;2;181;224;173:*.py=38;2;243;212;155'


# Alice Pastel - File viewing and search

# Syntax highlighting with bat
export BAT_THEME="ansi"
export BAT_STYLE="numbers,changes,header"

alias ccat='bat --paging=never'
alias preview='bat --paging=always'

# Colored search results
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

# Preserve ANSI colors in less
export LESS='-R'
export LESSHISTFILE='-'

