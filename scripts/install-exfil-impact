#!/bin/bash

# ==========================================================
# Alice Red Team Workstation - Exfiltration / Impact Installer
# ==========================================================

set -e

PINK="\033[1;35m"
CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

echo -e "${PINK}"
echo "    ___    __    ____________"
echo "   /   |  / /   /  _/ ____/ /"
echo "  / /| | / /    / // /   / / "
echo " / ___ |/ /____/ // /___/ /___"
echo "/_/  |_/_____/___/\____/_____/"
echo -e "${RESET}"

echo -e "${CYAN}ALICE RED TEAM WORKSTATION - EXFIL / IMPACT VALIDATION MODULE${RESET}"
echo

if ! command -v pacman >/dev/null 2>&1; then
    echo -e "${RED}[!] pacman not found. This installer is intended for Arch Linux based systems.${RESET}"
    exit 1
fi

if [ "$EUID" -eq 0 ]; then
    echo -e "${RED}[!] Do not run this script as root.${RESET}"
    echo -e "${YELLOW}Run it as your normal user. The script will ask for sudo when needed.${RESET}"
    exit 1
fi

# ----------------------------------------------------------
# Official packages
# ----------------------------------------------------------

echo -e "${PINK}[+] Installing exfiltration / impact validation support packages...${RESET}"

sudo pacman -Syu --needed \
    curl \
    wget \
    rsync \
    openssh \
    bind \
    tcpdump \
    wireshark-qt \
    wireshark-cli \
    jq \
    7zip \
    zip \
    unzip \
    gzip \
    tar \
    openssl \
    coreutils \
    python \
    flameshot \
    spectacle

# ----------------------------------------------------------
# Optional AUR packages
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Checking yay availability...${RESET}"

if command -v yay >/dev/null 2>&1; then
    echo -e "${PINK}[+] Installing optional AUR exfil / evidence tools where available...${RESET}"

    yay -S --needed \
        rclone \
        asciinema || true
else
    echo -e "${YELLOW}[!] yay is not installed. Skipping AUR-based tools.${RESET}"
fi

# ----------------------------------------------------------
# Workspace directories
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Creating exfiltration / evidence workspace directories...${RESET}"

mkdir -p "$HOME/Tools/exfil"
mkdir -p "$HOME/Tools/evidence"
mkdir -p "$HOME/Tools/egress-testing"
mkdir -p "$HOME/Labs/ExfilImpact"
mkdir -p "$HOME/Loot/exfil"
mkdir -p "$HOME/Loot/markers"
mkdir -p "$HOME/Loot/hashes"
mkdir -p "$HOME/Loot/pcaps"
mkdir -p "$HOME/Reports/exfil"

# ----------------------------------------------------------
# Marker file helper
# ----------------------------------------------------------

echo
echo -e "${PINK}[+] Creating local marker file helper...${RESET}"

cat > "$HOME/Scripts/create-marker-file" << 'MARKER'
#!/bin/bash

# create-marker-file - generate a synthetic marker file for approved exfil/impact validation
#
# Usage:
#   create-marker-file <name> <size>
#
# Examples:
#   create-marker-file marker-small.txt 1K
#   create-marker-file marker-10mb.bin 10M

if [ -z "$1" ] || [ -z "$2" ]; then
    echo "Usage: create-marker-file <name> <size>"
    echo "Example: create-marker-file marker-10mb.bin 10M"
    exit 1
fi

NAME="$1"
SIZE="$2"

dd if=/dev/urandom of="$NAME" bs="$SIZE" count=1 status=progress
sha256sum "$NAME" > "$NAME.sha256"

echo
echo "[+] Created: $NAME"
echo "[+] Hash: $NAME.sha256"
echo "[!] Use only under approved ROE."
MARKER

chmod +x "$HOME/Scripts/create-marker-file"

# ----------------------------------------------------------
# Final message
# ----------------------------------------------------------

echo
echo -e "${GREEN}[+] Exfiltration / Impact Validation module installation completed.${RESET}"
echo
echo -e "${CYAN}Recommended checks:${RESET}"
echo "curl --version"
echo "wget --version"
echo "rsync --version"
echo "ssh -V"
echo "dig -v"
echo "tcpdump --version"
echo "tshark --version"
echo "sha256sum --version"
echo "7z"
echo "create-marker-file test-marker.bin 1K"
echo
echo -e "${YELLOW}Notes:${RESET}"
echo "- This installer does not execute exfiltration."
echo "- This installer does not configure exfiltration channels."
echo "- This installer does not transfer data."
echo "- Use only synthetic, marker or explicitly approved data."
echo "- Always document ROE, data type, volume, channel, evidence and cleanup."
echo
