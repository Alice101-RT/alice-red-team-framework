set autoindent
set linenumbers
set mouse
set tabsize 4
set tabstospaces
set softwrap
set indicator
set minibar
set constantshow
set titlecolor brightmagenta,black
set statuscolor brightcyan,black
set errorcolor brightwhite,red
set selectedcolor brightwhite,magenta
set numbercolor brightcyan,black
set keycolor brightmagenta,black
set functioncolor brightcyan,black

# Syntax highlighting
include "/usr/share/nano/*.nanorc"
